PORT=5001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=artist_platform

# Localhost is always allowed. On Render, set FRONTEND_ORIGIN to the exact
# deployed frontend origin (for example, https://your-frontend.example).
FRONTEND_ORIGIN=http://localhost:5173

# Partner API configuration for upstream integrations.
PARTNER_URL=https://processing-put-gate-mine.trycloudflare.com
PARTNER_API_KEY=replace-with-the-partner-api-key
ARTISANS_API_URL=https://curriculum-tooth-ralph-pledge.trycloudflare.com/api/artisans
ARTISANS_API_KEY=replace-with-the-artisans-api-key

# Generate each key with: openssl rand -hex 32
API_KEY_DEVELOPMENT=replace-with-a-unique-64-character-hex-key
API_KEY_PARTNER=replace-with-a-different-unique-64-character-hex-key
USER_TOKEN_SECRET=replace-with-a-private-64-character-hex-secret

# Defaults: 100 requests per key per 60 seconds
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000